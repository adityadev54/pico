<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.7.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Pico</AssemblyName>
    <ApplicationIcon>Pico.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../assets/characters/mica/idle.gif" LogicalName="mica.idle.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/listening.gif" LogicalName="mica.listening.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/talking.gif" LogicalName="mica.talking.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/working.gif" LogicalName="mica.working.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/thinking.gif" LogicalName="mica.thinking.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/done.gif" LogicalName="mica.done.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/stuck.gif" LogicalName="mica.stuck.gif" />
    <EmbeddedResource Include="../../../assets/characters/mica/needsYou.gif" LogicalName="mica.needsYou.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/idle.gif" LogicalName="tuck.idle.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/listening.gif" LogicalName="tuck.listening.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/talking.gif" LogicalName="tuck.talking.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/working.gif" LogicalName="tuck.working.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/thinking.gif" LogicalName="tuck.thinking.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/done.gif" LogicalName="tuck.done.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/stuck.gif" LogicalName="tuck.stuck.gif" />
    <EmbeddedResource Include="../../../assets/characters/tuck/needsYou.gif" LogicalName="tuck.needsYou.gif" />
  </ItemGroup>
</Project>
