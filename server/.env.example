# Local server template. Copy to server/.env (gitignored) and never commit keys.
# The scaffold does not auto-load this file; pass it explicitly.
MUSE_API_URL=https://api.meta.ai/v1/chat/completions
MUSE_API_KEY=replace-with-local-key
MUSE_MODEL=muse-spark-1.3
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-key
PICO_ENV_FILE=server/.env

# Optional localhost tool bridge: export the same random token in both processes.
PICO_AGENT_TOKEN=replace-with-random-local-token
PICO_MODEL_ENABLED=0
