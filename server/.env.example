# Pico Server Environment Configuration Template
# Copy this file to .env (or server/.env) and fill in your values.
# NEVER commit your populated .env file with sensitive credentials.

# Meta Model API credentials and endpoint
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Agent Bounds
MAX_MODEL_TURNS=5
MAX_TOOL_CALLS=6

# Timeouts (in seconds)
REQUEST_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=30
TASK_DEADLINE_SECONDS=120

# Safety & Spending Limit (in USD)
SPENDING_LIMIT_DOLLARS=5.00

# Testing & Simulation Mode (set to true or 1 for offline testing without paid API keys)
MOCK_MODEL=false

